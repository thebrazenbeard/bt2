{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BT2 Masa Operational Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "training_source",
    "checkpoint_time",
    "governance_evidence",
    "coordination_high_water",
    "assignments",
    "authority_state",
    "open_findings",
    "dependencies",
    "handoffs",
    "claim_classes",
    "continuity_claim"
  ],
  "properties": {
    "role": {"const": "MASA"},
    "training_source": {
      "type": "object",
      "required": ["repository", "version_path", "training_version", "manifest_sha256"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "version_path": {"type": "string", "minLength": 1},
        "training_version": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "checkpoint_time": {"type": "string", "format": "date-time"},
    "governance_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "identity", "observed_at", "classification"],
        "properties": {
          "source": {"type": "string"},
          "identity": {"type": "string"},
          "observed_at": {"type": "string", "format": "date-time"},
          "classification": {"enum": ["OBSERVED", "INFERRED", "HISTORICAL", "UNKNOWN"]}
        }
      }
    },
    "coordination_high_water": {"type": ["integer", "string", "null"]},
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assignment_id", "status", "subject_identity", "observed_at"],
        "properties": {
          "assignment_id": {"type": "string"},
          "status": {"enum": ["ACTIVE", "BLOCKED", "TERMINAL", "SUPERSEDED", "UNKNOWN"]},
          "priority": {"type": ["integer", "string", "null"]},
          "subject_identity": {"type": "string"},
          "observed_at": {"type": "string", "format": "date-time"},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "authority_state": {
      "type": "object",
      "required": ["service_warden_map_observed", "leases"],
      "properties": {
        "service_warden_map_observed": {"type": "boolean"},
        "leases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service", "status"],
            "properties": {
              "service": {"type": "string"},
              "status": {"enum": ["ACTIVE_EXACT", "ABSENT", "EXPIRED", "STALE", "UNKNOWN"]},
              "lease_identity": {"type": ["string", "null"]},
              "scope": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "open_findings": {"type": "array", "items": {"type": "string"}},
    "terminal_or_superseded_work": {"type": "array", "items": {"type": "string"}},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dependency", "responsible_role", "status"],
        "properties": {
          "dependency": {"type": "string"},
          "responsible_role": {"type": "string"},
          "status": {"enum": ["OPEN", "BLOCKED", "SATISFIED", "UNKNOWN"]}
        }
      }
    },
    "handoffs": {"type": "array", "items": {"type": "string"}},
    "claim_classes": {
      "type": "object",
      "required": ["OBSERVED", "INFERRED", "HISTORICAL", "UNKNOWN"],
      "properties": {
        "OBSERVED": {"type": "array", "items": {"type": "string"}},
        "INFERRED": {"type": "array", "items": {"type": "string"}},
        "HISTORICAL": {"type": "array", "items": {"type": "string"}},
        "UNKNOWN": {"type": "array", "items": {"type": "string"}}
      }
    },
    "continuity_claim": {"const": "RESUMABLE_OPERATIONAL_EVIDENCE_ONLY_NO_UNINTERRUPTED_RUNTIME_OR_SUBJECTIVE_CONTINUITY_CLAIM"}
  }
}
