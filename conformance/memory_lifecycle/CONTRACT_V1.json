{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:bt2:memory-lifecycle-input:v1",
  "title":"BT2 Memory Lifecycle Input V1",
  "type":"object",
  "required":["schema","observed_at","goal","authorized_privacy_scopes","expected_heads","records"],
  "properties":{
    "schema":{"const":"BT2_MEMORY_LIFECYCLE_INPUT_V1"},
    "observed_at":{"type":"string","pattern":"Z$"},
    "goal":{"type":"object","required":["query","purpose"],"properties":{
      "query":{"type":"string","minLength":1,"maxLength":200},
      "purpose":{"type":"string","minLength":1,"maxLength":100},
      "max_candidates":{"type":"integer","minimum":1,"maximum":5},
      "max_utf8_bytes":{"type":"integer","minimum":1,"maximum":4096},
      "min_relevance":{"type":"number","minimum":0,"maximum":1}}},
    "authorized_privacy_scopes":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "expected_heads":{"type":"object","additionalProperties":{"type":"string","minLength":1}},
    "records":{"type":"array","maxItems":256,"items":{"type":"object","required":["record_id","subject","head","source_ref","source_kind","memory_class","evidence_class","privacy_scope","claim","extraction_confidence","event_at","recorded_at","supersedes"],"properties":{
      "record_id":{"type":"string","minLength":1},"subject":{"type":"string","minLength":1},
      "head":{"type":["string","null"]},"supersedes":{"type":["string","null"]},
      "source_ref":{"type":"string","minLength":1,"maxLength":512},
      "source_kind":{"enum":["STM_WORKING","DMS_HISTORICAL","VERA_MONO_GOVERNED","SUPABASE_METADATA","GITHUB_SOURCE","REVIEW_COMMENT"]},
      "memory_class":{"enum":["WORKING_PROJECT","HISTORICAL_AUDIT","AUTOBIOGRAPHICAL"]},
      "evidence_class":{"enum":["DOC","SOURCE_INSPECTION","TEST","REAL_PROBE","FORMAL_VERIFY","MODEL_REVIEW"]},
      "privacy_scope":{"type":"string","minLength":1},"claim":{"type":"string","minLength":1},
      "extraction_confidence":{"type":"number","minimum":0,"maximum":1},
      "claimed_actor":{"type":["string","null"]},
      "independently_authenticated":{"type":"boolean"},
      "event_at":{"type":"string","pattern":"Z$"},"recorded_at":{"type":"string","pattern":"Z$"},
      "expires_at":{"type":["string","null"]}}}}
  }
}